# ===== 数据库 =====
# MySQL 连接串（Prisma 格式）
DATABASE_URL="mysql://root:password@localhost:3306/ai_video"

# ===== AI 服务（OpenAI 兼容协议）=====
# 推荐接入中转站，便于切换模型
# 国内推荐：https://uniapi.ai  https://www.packyapi.com  https://poloai.top
# 国外推荐：https://openrouter.ai
AI_BASE_URL="https://api.your-relay.com/v1"
AI_API_KEY=""
# 推荐模型（综合考量前端能力、价格、吞吐）
AI_MODEL="gemini-3-flash-preview"

# ===== TTS（gpt-4o-mini-tts，OpenAI 兼容协议，复用 AI_BASE_URL）=====
# 可选音色: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar, nova
# 推荐 nova（女声，中文表现自然）
TTS_VOICE="nova"

# ===== 图片生成（evolink.ai z-image-turbo，性价比高）=====
# 注册地址：https://evolink.ai/z-image-turbo
# 重要：base URL 必须包含 /v1，代码会自动规范化（带不带 /v1 都行）
# 文档：https://evolink.ai/z-image-turbo
IMAGE_API_BASE_URL="https://api.evolink.ai/v1"
IMAGE_API_KEY=""

# ===== 应用配置 =====
NEXT_PUBLIC_APP_NAME="AI 视频制作智能体"
PORT=3000
