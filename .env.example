# 数据库（MySQL 8+，需 utf8mb4）
# 本地开发：直接填连接串。
# Docker Compose 部署：DATABASE_URL 会被 compose 自动覆盖成容器内网地址（mysql 服务名），
#   此处可保持默认；真正生效的是下面的 MYSQL_ROOT_PASSWORD / MYSQL_DATABASE。
DATABASE_URL="mysql://root:password@localhost:3306/ai_video"

# 仅 Docker Compose 部署需要：MySQL 容器初始化用的 root 密码与库名。
# 生产环境务必换成强随机串。密码会被拼进 DATABASE_URL 连接串，
# 请使用纯字母数字（如 openssl rand -hex 24），避免 @ : / # ? 等特殊字符破坏 URL 解析。
MYSQL_ROOT_PASSWORD="please-change-me-to-a-strong-password"
MYSQL_DATABASE="ai_video"

# 文本模型（OpenAI 兼容协议）——用于意图分析 / 大纲生成 / HTML 动画生成
AI_BASE_URL="https://your-openai-compatible-gateway/v1"
AI_API_KEY="sk-xxx"
AI_MODEL="gemini-3-flash-preview"

# 语音 TTS
# TTS_PROVIDER: openai（OpenAI 兼容 /audio/speech）| dashscope（阿里云百炼原生）
# base/key 缺省会回退到 AI_BASE_URL / AI_API_KEY，可共用同一账号
TTS_PROVIDER="openai"
TTS_MODEL="qwen3-tts-flash"
TTS_VOICE="nova"
# TTS_BASE_URL=""
# TTS_API_KEY=""

# 图片生成
# IMAGE_PROVIDER: evolink（两阶段任务：提交 -> 轮询）| dashscope（同步生图）
IMAGE_PROVIDER="evolink"
IMAGE_MODEL="z-image-turbo"
IMAGE_SIZE="16:9"
IMAGE_API_BASE_URL="https://api.evolink.ai"
IMAGE_API_KEY="your-image-key"

# 应用
NEXT_PUBLIC_APP_NAME="AI 视频制作智能体"

# 认证（Auth.js / NextAuth）
# NEXTAUTH_SECRET 用于加密会话 JWT，生产环境务必替换为随机长字符串
# 生成方式：openssl rand -base64 32  或  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="please-change-me-to-a-random-secret"
# 站点地址，本地开发即 http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
