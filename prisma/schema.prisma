// AI 视频制作智能体 — Prisma schema
// 数据库：MySQL 8.0+，需要 utf8mb4 字符集

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String // bcrypt 哈希后的密码
  name         String? // 显示名，可空
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]

  @@map("user")
}

model Project {
  uuid      String    @id // 雪花 ID，应用层生成
  title     String
  type      String // "image" | "html"
  styleId   String? // HTML 模式选中的视觉风格 id
  brief     Json? // 创作简报（唯一事实来源）：{topic, durationSec?, targetFrameCount?, tone?, constraints[]}
  outline   Json? // 视频大纲：{title, totalDuration, globalStyle?, frames: [...]}
  userId    String? // 归属用户；旧项目可能为空
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  frames    Frame[]
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
  @@map("project")
}

model Frame {
  id            String   @id @default(uuid())
  projectId     String
  frameId       String // 对应 outline.frames[i].id
  orderIndex    Int // 与 outline 顺序对齐（0-based）
  htmlCode      String?  @db.LongText // html 模式生成的完整 HTML
  imagePath     String? // image 模式：/api/data/images/<projectId>/<frameId>.png
  audioPath     String? // /api/data/audio/<projectId>/<frameId>.mp3
  audioDuration Float? // 秒
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [uuid], onDelete: Cascade)

  @@unique([projectId, frameId])
  @@index([projectId, orderIndex])
  @@map("frame")
}

model Message {
  id        String   @id // 雪花 ID，应用层生成
  projectId String
  role      String // "user" | "assistant"
  content   String   @db.Text
  metadata  Json? // 大纲卡片/分镜卡片/进度等结构化数据
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [uuid], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("message")
}

model StylePreset {
  id          String   @id // 雪花 ID，应用层生成
  slug        String   @unique // 业务 slug，如 "cyber-clean"
  name        String
  description String   @db.Text
  prompt      String   @db.Text // 拼接到 HTML 动画生成 prompt 的风格描述
  demoHtml    String   @db.LongText // 风格选择弹窗的演示 HTML
  userId      String? // null = 系统内置；有值 = 用户私有（为将来自定义风格预留）
  isBuiltin   Boolean  @default(true)
  sortOrder   Int      @default(0) // 展示排序，越小越靠前
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("style_preset")
}
